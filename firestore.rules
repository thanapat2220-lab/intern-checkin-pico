rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /attendance/{docId} {
      allow read, write: if true;
    }
    match /monthlyReviews/{docId} {
      allow read, write: if true;
    }
    match /payroll/{docId} {
      allow read, write: if true;
    }
    match /finalizedPayrollCycles/{cycleId} {
      allow read, write: if true;
    }
    match /approvalLinks/{token} {
      // Allow passwordless supervisor to look up single token and approve
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

